# MAITRI Environment Variables Configuration Template
# Copy this file to .env and configure your values

# Server Network Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ENVIRONMENT=production

# AI & LLM Provider Keys (Optional)
# If provided, MAITRI uses Google Gemini 1.5 Flash for online conversational responses.
# If omitted or offline, MAITRI seamlessly uses its internal autonomous psychological knowledge base.
GEMINI_API_KEY=

# Security & Session Configuration
SECRET_KEY=isro_maitri_spacecraft_secure_session_key_2025
SESSION_DURATION_HOURS=24
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
